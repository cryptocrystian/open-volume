# Public site
NEXT_PUBLIC_SITE_URL=https://openvolume.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@openvolume.com

# Social profiles — leave blank until the real profile URL is confirmed.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Audience capture
# HTTPS endpoint receiving JSON:
# { email, source, subscribedAt, consent }
OPEN_VOLUME_JOIN_WEBHOOK_URL=

# Optional bearer token sent to the audience-capture webhook.
OPEN_VOLUME_JOIN_WEBHOOK_TOKEN=

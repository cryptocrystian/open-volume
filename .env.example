# Public site
NEXT_PUBLIC_SITE_URL=https://openvolume.world
NEXT_PUBLIC_CONTACT_EMAIL=hello@openvolume.com

# Social profiles — leave blank until the real profile URL is confirmed.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Audience capture
# HTTPS endpoint receiving JSON:
# { email, source, subscribedAt, consent, subscriberKey, requestId }
# Recommended: point this at a private n8n webhook that performs CRM/email upsert,
# deduplication and welcome-message orchestration.
OPEN_VOLUME_JOIN_WEBHOOK_URL=

# Strong shared bearer token required by the receiving workflow in production.
OPEN_VOLUME_JOIN_WEBHOOK_TOKEN=
